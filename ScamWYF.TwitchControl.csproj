<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ScamWYF.TwitchControl</AssemblyName>
    <RootNamespace>ScamWYF.TwitchControl</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Security" />
  </ItemGroup>
  <Target Name="CheckDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == '' Or '$(ManagedDir)' == ''" Text="Run build.ps1 -GameDir &lt;game installation folder&gt;." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\core\BepInEx.dll')" Text="Cannot find BepInEx 5 under GameDir." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\core\0Harmony.dll')" Text="Cannot find Harmony under GameDir." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.dll')" Text="Cannot find UnityEngine.dll; check the game installation." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')" Text="Cannot find UnityEngine.CoreModule.dll." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.JSONSerializeModule.dll')" Text="Cannot find UnityEngine.JSONSerializeModule.dll; needed for Unity JsonUtility." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.IMGUIModule.dll')" Text="Cannot find UnityEngine.IMGUIModule.dll." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.TextRenderingModule.dll')" Text="Cannot find UnityEngine.TextRenderingModule.dll." />
  </Target>
</Project>
